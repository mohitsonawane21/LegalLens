{
  "edition": "OIML R 76-1:2006",
  "note": "Rule set used by r76.py. When OIML revises R 76, add a new JSON file (e.g. oiml_r76_2026.json) with the same structure and point RULES_FILE / the app setting to it - no code change needed.",
  "classes": {
    "I":   {"label": "Special accuracy (I)",  "mpe_bands": [[50000, 0.5], [200000, 1.0], [null, 1.5]]},
    "II":  {"label": "High accuracy (II)",    "mpe_bands": [[5000, 0.5],  [20000, 1.0],  [100000, 1.5]]},
    "III": {"label": "Medium accuracy (III)", "mpe_bands": [[500, 0.5],   [2000, 1.0],   [10000, 1.5]]},
    "IIII":{"label": "Ordinary accuracy (IIII)","mpe_bands": [[50, 0.5],  [200, 1.0],    [1000, 1.5]]}
  },
  "scale_interval_limits": {
    "I":   [{"e_min_g": 0.001, "e_max_g": null, "n_min": 50000, "n_max": null}],
    "II":  [{"e_min_g": 0.001, "e_max_g": 0.05, "n_min": 100,   "n_max": 100000},
            {"e_min_g": 0.1,   "e_max_g": null, "n_min": 5000,  "n_max": 100000}],
    "III": [{"e_min_g": 0.1,   "e_max_g": 2,    "n_min": 100,   "n_max": 10000},
            {"e_min_g": 5,     "e_max_g": null, "n_min": 500,   "n_max": 10000}],
    "IIII":[{"e_min_g": 5,     "e_max_g": null, "n_min": 100,   "n_max": 1000}]
  },
  "tests": {
    "weighing":      {"title": "Weighing test (accuracy)", "clause": "R 76-2 A.4.4", "min_loads": 5},
    "eccentricity":  {"title": "Eccentricity test",        "clause": "R 76-2 A.4.7", "load_fraction_of_max": 0.3333},
    "repeatability": {"title": "Repeatability test",       "clause": "R 76-2 A.4.10", "weighings": 3},
    "discrimination":{"title": "Discrimination test",      "clause": "R 76-2 A.4.8", "extra_load_in_d": 1.4}
  },
  "reference_conditions": {
    "temperature_c": [15, 25],
    "humidity_pct":  [20, 85],
    "pressure_hpa":  [860, 1060]
  }
}
